# Copiar como application-local.properties en la raíz del proyecto (ignorado por Git).
# Claves de Panel de Comercio sandbox > Desarrolladores > Claves.
# Son credenciales Web Core / Punto Web, distintas de Mi Cuenta Web / Krypton.
izipay.web.enabled=true
izipay.web.environment=sandbox
izipay.web.merchant-code=
izipay.web.api-key=
izipay.web.public-key=
izipay.web.hash-key=
izipay.web.payment-methods=CARD
# Después de habilitar las billeteras en el comercio:
# izipay.web.payment-methods=CARD,YAPE_CODE,PAGO_PUSH
# IPN: requiere una URL pública HTTPS de esta aplicación.
# Ruta: /payments/izipay/web/notification
izipay.web.ipn-url=
# Mantener desactivada la integración anterior.
izipay.enabled=false
